# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Shopify
SHOPIFY_SHOP_DOMAIN=YOUR_SHOP.myshopify.com

# Step 1: paste Client ID and Client Secret from Shopify Admin → Settings →
#         Apps and sales channels → your app → API credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Step 2: run `npm run get-shopify-token` — it will print the token below.
#         Paste the result here and you can delete the two vars above (or keep
#         them — they are only used by the one-time token script).
SHOPIFY_ADMIN_API_TOKEN=

# SendGrid
# Note: Inbound Parse uses URL-based token auth, not ECDSA signed webhooks.
# Set a long random string here and use it in your SendGrid Inbound Parse URL.
SENDGRID_INBOUND_TOKEN=your-long-random-token-here

# Database (Postgres)
DATABASE_URL=postgresql://framing:framing@localhost:5432/framing

# Redis
REDIS_URL=redis://localhost:6379

# Admin page
ADMIN_API_SECRET=your-admin-secret-here

# App
PORT=3000
NODE_ENV=development
